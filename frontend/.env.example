# Backend endpoints for VALCON.
#
# These are build-time defaults only. Every value can be overridden at runtime
# from Settings > Network, which is what you want on shared machines.

# Backend API (Render deployment)
VITE_API_URL=https://valcon-r5ti.onrender.com

# Local bridge daemon. Point this at a real host in production.
VITE_BRIDGE_URL=http://localhost:3000

# Optional music endpoints. Leave empty to keep imports local-only.
VITE_MUSIC_UPLOAD_URL=
VITE_MUSIC_PLAY_URL=
# Local-only overrides (never commit real secrets here)
# .env.local
